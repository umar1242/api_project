{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@bot/core": [
        "../../packages/bot-core/src/index.ts",
        "./packages/bot-core/src/index.ts",
        "/app/packages/bot-core/src/index.ts"
      ],
      "@bot/core/*": [
        "../../packages/bot-core/src/*",
        "./packages/bot-core/src/*",
        "/app/packages/bot-core/src/*"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
