# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ──────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_NAME=botnet_dev

# IMPORTANT: Docker env_file does NOT expand ${VAR} — write the full URL literally!
DATABASE_URL=postgresql://postgres:your_strong_password_here@db:5432/botnet_dev?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ─── Internal Service Auth ──────────────────────────────────────
# Shared secret used by all bots to authenticate against the API
SERVICE_TOKEN=change_me_to_a_long_random_string

# ─── Telegram ──────────────────────────────────────────────────
# Used by the API to verify Mini App initData signatures
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Bot Tokens (one per bot) ──────────────────────────────────
ADMIN_BOT_TOKEN=
CERT_BOT_TOKEN=
REGISTRAR_BOT_TOKEN=
MAIN_BOT_TOKEN=
HOMEWORK_BOT_TOKEN=
MATERIAL_BOT_TOKEN=

# ─── Mini App URLs (Generated by start_cloudflared_tunnels.sh) ──
ADMIN_WEBAPP_URL=
MAIN_WEBAPP_URL=
HOMEWORK_WEBAPP_URL=
MATERIAL_WEBAPP_URL=
CERT_WEBAPP_URL=
REGISTRAR_WEBAPP_URL=

# ─── File Storage (MinIO / S3-compatible) ───────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=variant-files
